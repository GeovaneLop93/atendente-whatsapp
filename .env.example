# ===== Atendente WhatsApp (piloto) — exemplo de configuracao =====
# Copie para .env, preencha e rode: chmod 600 .env
# NUNCA versione o .env (ja esta no .gitignore).

# --- Recebedor HTTP ---
ATENDENTE_HOST=127.0.0.1
ATENDENTE_PORT=8895
# Token exigido no header do webhook (Evolution deve mandar o mesmo valor).
# Header: X-Webhook-Token
WEBHOOK_TOKEN=troque-por-um-token-forte

# --- Banco (piloto roda em SQLite local; Supabase e pendencia do Geovane) ---
# Vazio = SQLite em data/atendente.db (default do piloto).
# Para apontar ao Supabase self-hosted depois de o Geovane aplicar sql/001:
#   DATABASE_URL=postgresql://USER:SENHA@HOST:PORTA/postgres
# (nunca comite senha; prefira PGPASSWORD no ambiente da unit)
DATABASE_URL=

# --- Motor de texto (assinatura OAuth via CLI; SEM API paga) ---
CLAUDE_BIN=claude
CODEX_BIN=codex
MOTOR_TIMEOUT_S=120

# --- Evolution API (envio de texto) ---
# Em piloto DRYRUN=true: NAO envia mensagem real, apenas registra o payload.
# O Geovane troca para false depois de criar a instancia e o apikey.
EVOLUTION_DRYRUN=true
EVOLUTION_BASE_URL=https://sua-instancia-evolution.exemplo.com
EVOLUTION_INSTANCE=atendente-piloto
# Segredo — so no .env real, nunca aqui com valor:
EVOLUTION_APIKEY=

# --- Qualificacao / resposta ---
# Quantas ultimas mensagens entram no contexto do motor.
CONTEXTO_ULTIMAS_MSGS=12
# Tamanho maximo por mensagem enviada e numero maximo de mensagens por resposta.
RESPOSTA_MAX_CHARS=600
RESPOSTA_MAX_PARTES=2

# --- Follow-up ---
# Segundos de silencio para o 1o e o 2o follow-up. Defaults de producao: 4h e 24h.
# Para DEMONSTRAR, reduza (ex.: 2 e 4).
FOLLOWUP_1_SEGUNDOS=14400
FOLLOWUP_2_SEGUNDOS=86400
FOLLOWUP_MAX=2
# Janela de silencio noturno (hora local SP). Nao envia follow-up nesse intervalo.
FOLLOWUP_NOITE_INICIO=21
FOLLOWUP_NOITE_FIM=8
TZ_LOCAL=America/Sao_Paulo
